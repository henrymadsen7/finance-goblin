{
  "name": "finance-goblin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-timeout=15000 test/*.test.js",
    "check": "tsc --noEmit",
    "format": "prettier --write src server test vite.config.js tsconfig.json",
    "desktop": "electron .",
    "desktop:build": "npm run build && node scripts/package-desktop.mjs",
    "desktop:install": "npm run desktop:build -- --install",
    "check:source": "node scripts/check-source.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@actual-app/api": "26.11.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "ical.js": "2.2.1",
    "js-tiktoken": "1.0.21",
    "liquid-glass-react": "1.1.1",
    "lucide-react": "1.71.0",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "fsevents": false
  },
  "main": "desktop/main.cjs",
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "license": "MIT",
  "description": "Local-first personal finance desktop app with interactive cash-flow charts.",
  "author": "Finance Goblin contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/henrymadsen7/finance-goblin.git"
  },
  "bugs": {
    "url": "https://github.com/henrymadsen7/finance-goblin/issues"
  },
  "homepage": "https://github.com/henrymadsen7/finance-goblin#readme"
}
